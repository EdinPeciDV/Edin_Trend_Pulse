# sysrfx_predictor/.env — copy this file to `.env` in the SAME directory
# (sysrfx_predictor/, not the repo root) and fill in whatever you have.
# Every one of these is optional except in the sense noted; the script
# runs with NONE of them set, using local SQLite storage and skipping
# every optional feature (on-chain, macro, on-line Supabase logging).

# --- Storage (recommended, not required — SQLite fallback otherwise) ---
# Supabase project settings -> API. Anon key is enough for read/write if
# your RLS policies allow it; a service-role key bypasses RLS entirely,
# so prefer the anon key + policies unless you have a reason not to.
SUPABASE_URL=
SUPABASE_KEY=
# Optional: Supabase project settings -> Database -> Connection string
# ("URI", Postgres, NOT the pooler-only one if you want DDL to work).
# Set this and the script will auto-create bars/predictions/model_metadata
# on startup; leave it blank and run schema.sql by hand once instead.
SUPABASE_DB_URL=

# --- Module 3: on-chain features (crypto only) ---
# Free tier: https://studio.glassnode.com/ -> Settings -> API
GLASSNODE_API_KEY=

# --- Module 4 (macro, forex leg): interest-rate differential ---
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Module 4 (macro, forex leg): US CPI, monthly ---
# Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=
