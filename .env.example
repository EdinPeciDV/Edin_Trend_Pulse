# ===================================================================
# Copy to .env for local development. NEVER commit .env.
# In production these live in the Netlify UI � see README.md.
# ===================================================================

# --- Exposed to the browser (VITE_ prefix = public by design) --------
# The publishable key is safe to ship publicly. It only grants what your
# RLS policies allow, which is why migrations.sql locks every user table.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# --- Server-side only. NEVER prefix these with VITE_ -----------------
# The secret key bypasses RLS entirely. If it reaches the browser,
# anyone can read and write every table.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# Free key from https://twelvedata.com (forex data)
TWELVE_DATA_API_KEY=your-twelve-data-key

# Optional: set to api.binance.us if api.binance.com returns HTTP 451
# BINANCE_HOST=api.binance.com

# Optional: lock CORS to your own domain instead of *
# ALLOWED_ORIGIN=https://your-site.netlify.app

# --- Billing (Paddle) -------------------------------------------------
# Client-side token, public by design — scoped to opening a checkout,
# nothing more. Paddle dashboard -> Developer Tools -> Authentication.
VITE_PADDLE_CLIENT_TOKEN=your-paddle-client-side-token
# 'sandbox' while testing, 'production' when you're ready to take real
# payments. Defaults to 'production' if unset — set this explicitly
# while testing or you WILL create real transactions.
VITE_PADDLE_ENVIRONMENT=sandbox

# Same price IDs on both sides: VITE_-prefixed so the Subscribe button
# knows what to open checkout for, unprefixed so the webhook (a Netlify
# Function, not the browser bundle) knows which plan a payment maps to.
VITE_PADDLE_PRICE_ID_BASIC=pri_your-basic-price-id
VITE_PADDLE_PRICE_ID_PRO=pri_your-pro-price-id
PADDLE_PRICE_ID_BASIC=pri_your-basic-price-id
PADDLE_PRICE_ID_PRO=pri_your-pro-price-id

# Webhook signing secret. Paddle dashboard -> Developer Tools ->
# Notifications -> your destination -> "reveal" the secret key
# (starts with pdl_ntfset_). Server-side only.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your-webhook-secret
